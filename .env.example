# ─────────────────────────────────────────────────────────────
#  Variables de entorno
#  Copia este archivo a `.env` para desarrollo local.
#  En Railway, define estas mismas variables en la pestaña "Variables".
# ─────────────────────────────────────────────────────────────

# Postgres. En Railway, al añadir el plugin de Postgres, esta variable
# se inyecta SOLA. En local, apunta a tu Postgres local.
DATABASE_URL=postgresql://user:password@localhost:5432/practica

# Pon "true" SOLO si tu conexión a Postgres exige SSL (típico al conectar
# a la URL pública de Railway desde tu máquina). En la red privada de
# Railway normalmente se deja en "false".
PGSSL=false

# Secreto para firmar los JWT. GENERA UNO LARGO Y ALEATORIO.
# Ej: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# El código de recompensa que se entrega al completar los retos.
# NUNCA lo pongas en el código fuente ni en el repo. Solo aquí / en Railway.
REWARD_CODE=reemplaza-con-tu-codigo-de-recompensa-real

# Cuenta sembrada para el aprendiz (esto SÍ se lo das tú a Andrea).
SEED_USERNAME=Andrea
SEED_PASSWORD=

# Origen(es) del frontend, separados por coma, para CORS con credenciales.
# DEBE ser específico (no "*") porque usamos cookies con credentials.
# Ej local: http://localhost:5173
# Ej deploy: https://mi-frontend.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Latencia simulada en ms para los endpoints de práctica (contrato pide ~800).
SIMULATED_LATENCY_MS=800

# Probabilidad (0..1) de un 500 aleatorio en /register (contrato pide ~0.15).
RANDOM_500_RATE=0.15

# Si es "true", además de la cookie se acepta el token por cabecera
# (Authorization: Bearer <token> o x-session-token).
# Déjalo en "false" para FORZAR la experiencia de cookie que diseñaste.
# Ponlo en "true" si el flujo cross-site de cookies te complica el desarrollo.
ALLOW_HEADER_AUTH=false

# Puerto. Railway lo inyecta solo; en local usa 3000.
PORT=3000

# "production" en Railway, "development" en local.
NODE_ENV=development
